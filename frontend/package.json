{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs",
    "test:ui": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=moderate",
    "ci": "npm ci --ignore-scripts && npm run audit:prod && npm run check && playwright install --with-deps chromium && npm run test:ui && npm run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tsconfig/svelte": "5.0.8",
    "autoprefixer": "10.5.4",
    "playwright": "1.62.1",
    "postcss": "8.5.25",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "svelte-preprocess": "6.0.5",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  }
}
